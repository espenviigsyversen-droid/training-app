rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Existing shared-project rules. Keep these compatible with the other apps.
    match /users/{userId}/{document=**} {
      allow read, write: if owns(userId);
    }

    match /households/home/{document=**} {
      allow read, write: if signedIn();
    }

    match /families/familieoppdrag/{document=**} {
      allow read, write: if signedIn();
    }

    match /families/familie-esyvers/{document=**} {
      allow read, write: if signedIn();
    }

    match /families/{familyId}/{document=**} {
      allow read, write: if signedIn();
    }

    match /familyCodes/{code} {
      allow read, write: if signedIn();
    }

    match /adminFamilyHealth/{familyId} {
      allow read: if signedIn()
        && request.auth.token.email == "espen.viig.syversen@gmail.com";
      allow create, update: if signedIn()
        && request.resource.data.cloudFamilyId == familyId;
      allow delete: if false;
    }

    match /families/familien/{document=**} {
      allow read, write: if signedIn();
    }

    // Secrets and usage counters are backend-only. Admin SDK bypasses Rules.
    match /apiKeys/{userId} {
      allow read, write: if false;
    }

    match /aiUsage/{userId} {
      allow read, write: if false;
    }

    // Chat is deliberately outside users/{uid}; the existing recursive owner
    // rule there would otherwise make backend-only writes impossible to enforce.
    match /aiChatUsers/{userId} {
      allow read: if owns(userId);
      allow write: if false;

      match /projects/{projectId} {
        allow read: if owns(userId);
        allow write: if false;

        match /conversations/{conversationId} {
          allow read: if owns(userId);
          allow write: if false;

          match /messages/{messageId} {
            allow read: if owns(userId);
            allow write: if false;
          }
        }
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

